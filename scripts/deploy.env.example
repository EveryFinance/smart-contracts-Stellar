# Core
NETWORK=testnet
SOURCE_ACCOUNT=deployer

# Role accounts (can be aliases or G... addresses)
MANAGER_ACCOUNT=deployer
MANAGER_SIGNER=deployer
TRADER_ACCOUNT=deployer
FACTORY_ADMIN_ACCOUNT=deployer
FACTORY_ADMIN_SIGNER=deployer
ORACLE_ADMIN_ACCOUNT=deployer
ORACLE_ADMIN_SIGNER=deployer

# Vault/share settings
BASE_ASSET_CLASSIC=native
SHARE_TOKEN_NAME=Vault Share
SHARE_TOKEN_SYMBOL=VSHARE
SHARE_TOKEN_DECIMALS=7
ENTRY_FEE_BPS=0
EXIT_FEE_BPS=0
MGMT_FEE_BPS=0
PERF_FEE_BPS=0
ORACLE_MAX_AGE_LEDGERS=17280

# Guards
DEPLOY_GUARDS=true
# Comma-separated contract IDs. Empty => base asset only.
GUARD_WHITELIST=

# Optional strategy deployments (need protocol addresses)
