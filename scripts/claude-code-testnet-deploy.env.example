# Source this file before running scripts/deploy_testnet_protocol_environment.sh.
# It contains only public/local deployment settings, not private keys.

# Network and Stellar CLI source account.
NETWORK=testnet
SOURCE_ACCOUNT=deployer

# Protocol roles. These can be Stellar CLI key aliases or G... addresses.
# The signer values must be local Stellar CLI key aliases that can authorize txs.
MANAGER_ACCOUNT=deployer
MANAGER_SIGNER=deployer
TRADER_ACCOUNT=deployer
TRADER_SIGNER=deployer
TREASURY_ACCOUNT=deployer
ADMIN_ACCOUNT=deployer
ADMIN_SIGNER=deployer

# Vault fee configuration requested for Alpha/Beta/Gamma.
ENTRY_FEE_BPS=0
EXIT_FEE_BPS=0
MGMT_FEE_BPS=200
PERF_FEE_BPS=1000

# Share token policy.
# The script sets share transfers disabled on each vault.
COOLDOWN_SECS=60
WAIT_FOR_COOLDOWN=true
COOLDOWN_SLEEP_SECS=70

# Beta gate.
# Keep false until Beta completes with zero failed transactions.
DEPLOY_ALPHA_GAMMA_AFTER_BETA=false

# Stellar RPC retry behavior for transient testnet issues.
STELLAR_RETRY_ATTEMPTS=4
STELLAR_RETRY_SLEEP_SECS=8

# Demo/test user key aliases. The script creates and funds them if missing.
USER1_KEY=protocol_demo_user_1
USER2_KEY=protocol_demo_user_2

# Mock token mint amounts, using 7 decimals.
USER_MINT_AMOUNT=100000000000
MANAGER_MINT_AMOUNT=100000000000

# Transaction flow amounts, using 7 decimals.
USER_DEPOSIT_AMOUNT=1000000000
USER_WITHDRAW_SHARES=200000000

# Initial mock oracle prices, PRICE_PRECISION = 1e7.
# Override these immediately before a run if fresher market prices are required.
PRICE_USDC=10000000
PRICE_XLM=1700000
PRICE_BTC=816844300000
PRICE_PYUSD=10000000
PRICE_EURC=10800000
PRICE_AQUA=4500
PRICE_USTRY=10300000

